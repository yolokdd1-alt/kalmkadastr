[Unit]
Description=Kalmkadastr enquiry API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=kalmkadastr
Group=kalmkadastr
WorkingDirectory=/opt/kalmkadastr
EnvironmentFile=/etc/kalmkadastr.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
